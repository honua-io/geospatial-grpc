# Build / generation outputs (produced by CI and local tooling, never committed)
/dist/
/gen/
/generated/
/descriptors/
/nupkgs/
/packages/python/src/
/packages/python/dist/
/packages/python/*.egg-info/
/packages/typescript/src/
/packages/typescript/dist/
/packages/typescript/*.tgz
/packages/typescript/LICENSE
/packages/typescript/node_modules/

# Python release-tooling caches
__pycache__/
*.py[cod]

# .NET build artifacts
**/bin/
**/obj/
